{
  "manifest_version": 3,
  "name": "Receipts: Spending Calculator & Hidden Fee Finder",
  "short_name": "Receipts",
  "version": "0.2.3",
  "description": "Adds up a year of your online orders and finds every platform, delivery and packing fee on top. Read privately on your laptop.",
  "minimum_chrome_version": "139",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Open Receipts",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "unlimitedStorage", "scripting", "activeTab"],
  "optional_host_permissions": [
    "https://www.amazon.in/*",
    "https://www.amazon.com/*",
    "https://www.swiggy.com/*",
    "https://www.flipkart.com/*",
    "https://www.myntra.com/*",
    "https://www.ajio.com/*",
    "https://www.tatacliq.com/*",
    "https://blinkit.com/*",
    "https://www.jiomart.com/*",
    "https://in.bookmyshow.com/*",
    "https://riders.uber.com/*",
    "https://www.walmart.com/*",
    "https://www.target.com/*",
    "https://www.doordash.com/*",
    "https://www.ubereats.com/*",
    "https://www.instacart.com/*",
    "https://www.ebay.com/*",
    "https://www.etsy.com/*"
  ]
}
