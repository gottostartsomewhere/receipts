{
  "manifest_version": 3,
  "name": "Receipts",
  "version": "0.1.0",
  "description": "Your year of shopping, wrapped. Orders are read on your laptop by Gemini Nano; only a few totals ever leave it.",
  "minimum_chrome_version": "139",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Open Receipts",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "unlimitedStorage", "scripting", "activeTab"],
  "optional_host_permissions": [
    "https://www.amazon.in/*",
    "https://www.amazon.com/*",
    "https://www.swiggy.com/*",
    "https://www.zomato.com/*",
    "https://www.flipkart.com/*"
  ]
}
