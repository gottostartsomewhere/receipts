# Firebase web app config (Firebase console > Project settings > Your apps > Web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check debug token registered in Firebase console > App Check > Apps > Manage debug tokens.
# MV3 extensions cannot load reCAPTCHA, so the extension build uses the debug provider.
# Never commit a real value.
VITE_APPCHECK_DEBUG_TOKEN=

# Optional: override the cloud model used to write the Wrapped.
VITE_CLOUD_MODEL=gemini-3.8-flash
